# 复制这个文件为 .env，填好后用 npm run dev 启动
#   cp .env.example .env
# .env 已在 .gitignore 里，不会进仓库。

# 必填。Console → Settings → API keys
# 直接粘贴，不要加引号，注意首尾别带空格
ANTHROPIC_API_KEY=sk-ant-

# 只有跨 workspace 的 key 才需要（报错提到 anthropic-workspace-id 时）
# Console → Settings → Workspaces，复制 wrkspc_ 开头的 ID
ANTHROPIC_WORKSPACE_ID=

# 可选。生成用的模型，默认 claude-sonnet-5
# MODEL=claude-sonnet-5
# 可选。裁判用的模型，默认同 MODEL；跑 npm run calibrate 比较后可换 Haiku
# JUDGE_MODEL=claude-haiku-4-5-20251001
# 可选。模拟对局的提问方，默认 Haiku
# SOLVER_MODEL=claude-haiku-4-5-20251001

# 可选。对局和积分存哪。不设就存内存（本地够用）；Render 上由 render.yaml 自动注入
# REDIS_URL=redis://...

# ---- 裁判速度 ----
# 裁判的 effort，默认 low（快）。判定不准时改 medium；设成空就不发这个参数
# JUDGE_EFFORT=low
# 同时最多几个请求打到 API / 排队最多等几秒 / 一次裁定最多花几秒
# JUDGE_CONCURRENCY=8
# JUDGE_QUEUE_SECONDS=10
# JUDGE_BUDGET_SECONDS=25

# ---- 积分 ----
# 解开一道新题得几分 / 一条付费提示要几分 / 每道题前几条提示免费
# POINTS_PER_SOLVE=1
# HINT_COST=1
# FREE_HINTS=1

# ---- 广告（现在没开，不设就不会加载） ----
# 本地试广告流程：用页面自带的假广告，不连 Google。线上不要开。
# ADS_MOCK=1
# AdSense 发布商 ID（ca-pub- 开头）。H5 Games Ads 申请批下来之后填
# ADSENSE_CLIENT=ca-pub-
# 1 = Google 测试模式：显示 Google 的模拟广告，不发真实请求
# ADS_TEST=1
# 广告票据至少隔几秒才认
# AD_MIN_SECONDS=5

# 可选。设成 1 会把模型每次的原始返回打进日志，调完关掉
# DEBUG_RAW=1
