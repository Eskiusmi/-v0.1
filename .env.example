# 复制这个文件为 .env，填好后用 npm run dev 启动
#   cp .env.example .env
# .env 已在 .gitignore 里，不会进仓库。

# 必填。Console → Settings → API keys
# 直接粘贴，不要加引号，注意首尾别带空格
ANTHROPIC_API_KEY=sk-ant-

# 只有跨 workspace 的 key 才需要（报错提到 anthropic-workspace-id 时）
# Console → Settings → Workspaces，复制 wrkspc_ 开头的 ID
# 用绑定单一 workspace 的 key 就把这行删掉或留空
ANTHROPIC_WORKSPACE_ID=

# 可选。session 存储。不设就存内存（本地开发够用）。
# Render 上由 render.yaml 自动注入，不用手填。
# REDIS_URL=redis://...

# 可选。裁判用的模型，不填默认 claude-sonnet-5
# MODEL=claude-haiku-4-5-20251001

# 可选。生成谜题时模拟对局用的模型，不填默认 haiku
# SOLVER_MODEL=claude-haiku-4-5-20251001

# 可选。Sonnet 5 起不接受这个参数，别设。
# 只有回退到老模型时才需要
# TEMPERATURE=0.15

# 可选。设成 1 会把模型每次的原始返回打进日志，调裁判时用
# 调完关掉——日志里有可以反推汤底的信息
# DEBUG_RAW=1
